package check

import (
	"fmt"

	"github.com/templui/templui/components/alert"
	"github.com/templui/templui/components/badge"
	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/card"
	"github.com/templui/templui/components/form"
	"github.com/templui/templui/components/label"
	"github.com/templui/templui/components/radio"
	"github.com/templui/templui/components/textarea"
	"github.com/kairosedubf/wobsongo/model"
	"github.com/kairosedubf/wobsongo/service"
	"github.com/kairosedubf/wobsongo/view/layout"
)

// FormPageData holds data for the claim-check page.
type FormPageData struct {
	layout.AppLayoutData
	// Text is the submitted claim, re-shown on re-render (success or error).
	Text string
	// IsLong mirrors dto.CheckClaimDTO.IsLong — selects which submitted
	// "mode" radio was checked, re-shown on re-render like Text. Also
	// decides how much of Result's already-fully-populated SubClaims to
	// render: short shows BriefReasoning only, long shows Reasoning plus
	// citations.
	IsLong bool
	Result *service.ClaimCheckResult
	Error  string
}

// verdictBadgeClass maps a Verdict to a color-coded badge override —
// components/badge only has 4 generic variants, none of which carry a
// verdict's meaning, so this overrides the badge's background/text/border
// directly instead.
func verdictBadgeClass(v model.Verdict) string {
	switch v {
	case model.VerdictSupported:
		return "bg-green-100 text-green-800 border-green-300 dark:bg-green-950 dark:text-green-300 dark:border-green-800"
	case model.VerdictContradicted:
		return "bg-red-100 text-red-800 border-red-300 dark:bg-red-950 dark:text-red-300 dark:border-red-800"
	case model.VerdictPartiallySupported, model.VerdictMixed:
		return "bg-amber-100 text-amber-800 border-amber-300 dark:bg-amber-950 dark:text-amber-300 dark:border-amber-800"
	default:
		return "bg-muted text-muted-foreground border-border"
	}
}

templ Form(data FormPageData) {
	{{ data.Breadcrumbs = []layout.Crumb{{Label: "Check", Href: ""}} }}
	@layout.App(data.AppLayoutData) {
		<div class="max-w-2xl">
			if data.Error != "" {
				<div class="mb-4">
					@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
						@alert.Description() {
							{ data.Error }
						}
					}
				</div>
			}
			<form method="POST" action="/check" class="flex flex-col gap-4 mb-8">
				<input type="hidden" name="_csrf" value={ data.CSRFToken }/>
				@form.Item() {
					@label.Label(label.Props{For: "text"}) {
						Claim
					}
					@textarea.Textarea(textarea.Props{
						ID:          "text",
						Name:        "text",
						Value:       data.Text,
						Rows:        4,
						Placeholder: "Enter a claim to check against the knowledge base…",
					})
				}
				@form.Item() {
					@label.Label() {
						Detail level
					}
					<div class="flex items-center gap-4 text-sm">
						<label class="flex items-center gap-2">
							@radio.Radio(radio.Props{Name: "mode", Value: "short", Checked: !data.IsLong})
							Short
						</label>
						<label class="flex items-center gap-2">
							@radio.Radio(radio.Props{Name: "mode", Value: "long", Checked: data.IsLong})
							Long
						</label>
					</div>
				}
				@button.Button(button.Props{Type: button.TypeSubmit}) {
					Check claim
				}
			</form>
			if data.Result != nil {
				if !data.Result.InScope {
					@alert.Alert() {
						@alert.Description() {
							{ data.Result.RefusalReason }
						}
					}
				} else {
					if data.Result.OverallSummary != "" {
						<p class="text-sm text-muted-foreground mb-4">{ data.Result.OverallSummary }</p>
					}
					<div class="flex flex-col gap-4">
						for _, sub := range data.Result.SubClaims {
							@card.Card() {
								@card.Header() {
									@card.Title(card.TitleProps{Class: "text-base"}) {
										{ sub.Claim }
									}
									<div class="flex items-center gap-2 mt-1">
										@badge.Badge(badge.Props{Class: verdictBadgeClass(sub.Verdict)}) {
											{ fmt.Sprintf("%s %s", sub.Verdict.Emoji(), sub.Verdict.String()) }
										}
										<span class="text-xs text-muted-foreground">
											{ "severity: " + sub.Severity.String() }
										</span>
									</div>
								}
								@card.Content(card.ContentProps{Class: "pt-4"}) {
									if data.IsLong {
										<p class="text-sm">{ sub.Reasoning }</p>
									} else {
										<p class="text-sm">{ sub.BriefReasoning }</p>
									}
									if sub.RecommendMedicalConsult {
										<p class="text-sm text-amber-700 dark:text-amber-400 mt-2">
											Please consult a medical professional.
										</p>
									}
									if data.IsLong && len(sub.Citations) > 0 {
										<div class="mt-4 border-t pt-3">
											<p class="text-xs font-medium text-muted-foreground mb-2">Citations</p>
											<ul class="flex flex-col gap-2">
												for _, cite := range sub.Citations {
													<li class="text-xs text-muted-foreground">
														<a
															href={ templ.SafeURL(fmt.Sprintf("/evidence?document_id=%s&chunk_id=%s", cite.DocumentID, cite.ChunkID)) }
															target="_blank"
															rel="noopener"
															class="font-medium text-foreground hover:underline"
														>
															{ fmt.Sprintf("[%d] %s", cite.Index, cite.Source) }
														</a>
									if cite.TableMarkdown != "" {
										<pre class="mt-1 whitespace-pre-wrap font-mono">{ cite.TableMarkdown }</pre>
									} else if cite.Text != "" {
															<span>{ " — " + cite.Text }</span>
														}
													</li>
												}
											</ul>
										</div>
									}
								}
							}
						}
					</div>
				}
			}
		</div>
	}
}
